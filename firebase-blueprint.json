{
  "entities": {
    "collectedCedula": {
      "title": "CollectedCedula",
      "description": "Cédulas consultadas y registradas por los electores y el equipo de campaña",
      "type": "object",
      "properties": {
        "cedula": { "type": "string" },
        "nombre": { "type": "string" },
        "barrio": { "type": "string" },
        "localVotacion": { "type": "string" },
        "mesa": { "type": "string" },
        "orden": { "type": "string" },
        "responsable": { "type": "string" },
        "telefono": { "type": "string" },
        "observaciones": { "type": "string" },
        "pasoPorMesa": { "type": "boolean" },
        "horaVoto": { "type": "string" },
        "registradoPor": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["cedula", "createdAt"]
    },
    "campaignConfig": {
      "title": "CampaignConfig",
      "description": "Configuración visual e institucional de la campaña y candidato",
      "type": "object",
      "properties": {
        "candidateName": { "type": "string" },
        "candidateRole": { "type": "string" },
        "listNumber": { "type": "string" },
        "optionNumber": { "type": "string" },
        "campaignSlogan": { "type": "string" },
        "candidatePhotoUrl": { "type": "string" },
        "backgroundUrl": { "type": "string" },
        "headerLogoUrl": { "type": "string" },
        "footerLogoUrl": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["candidateName", "listNumber", "campaignSlogan"]
    },
    "padronChunk": {
      "title": "PadronChunk",
      "description": "Bloque de electores del padrón oficial sincronizados en la nube",
      "type": "object",
      "properties": {
        "chunkIndex": { "type": "number" },
        "items": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["chunkIndex", "items"]
    }
  },
  "firestore": {
    "/cedulas_recopiladas/{cedulaId}": {
      "schema": "collectedCedula",
      "description": "Registro en tiempo real de cédulas y votantes"
    },
    "/campaign_config/{docId}": {
      "schema": "campaignConfig",
      "description": "Configuración y fotos del candidato y campaña compartida entre dispositivos"
    },
    "/padron_electores/{chunkId}": {
      "schema": "padronChunk",
      "description": "Padrón electoral cargado y compartido en la nube"
    }
  }
}
